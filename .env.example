# Корневой .env — только для Docker Compose (порты, контейнер db).
# Секреты, SMTP, JWT, BOT_TOKEN — в backend/.env (см. backend/.env.example).

POSTGRES_USER=educrm
POSTGRES_PASSWORD=educrm
POSTGRES_DB=educrm
# 5433 — если на ПК уже занят 5432 (локальный PostgreSQL)
POSTGRES_PORT=5433

BACKEND_PORT=5000
FRONTEND_PORT=80
CLIENT_URL=http://localhost
NODE_ENV=production

# DATABASE_URL=postgresql://...@host.docker.internal:5432/...  # своя БД на хосте

# В backend/.env — первый админ создаётся seed только если в БД нет ADMIN:
# ADMIN_EMAIL=admin@example.com
# ADMIN_FIRST_NAME=Имя
# ADMIN_LAST_NAME=Фамилия
# ADMIN_PHONE=89001234567
