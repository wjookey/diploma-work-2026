// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  PARENT
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  firstName String @map("first_name")
  lastName String @map("last_name")
  phone String
  role Role @default(PARENT)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher Teacher?
  parent Parent?

  @@map("users")
}

model Teacher {
  id Int @id @default(autoincrement())
  userId Int @unique @map("user_id")
  specialty String?
  bio String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubs Club[]

  @@map("teachers")
}

model Parent {
  id Int @id @default(autoincrement())
  userId Int @unique @map("user_id")
  familyId Int @map("family_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("parents")
}

model Child {
  id Int @id @default(autoincrement())
  firstName String @map("first_name")
  lastName String @map("last_name")
  birthDate DateTime? @map("birth_date")
  familyId Int @map("family_id")
  note String?
  createdAt DateTime @default(now()) @map("created_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("children")
}

model Family {
  id Int @id @default(autoincrement())
  parentOneId Int @unique @map("parent_one_id")
  parentTwoId Int? @unique @map("parent_two_id")
  createdAt DateTime @default(now()) @map("created_at")

  children Child[]
  parents Parent[]

  @@unique([parentOneId, parentTwoId])
  @@map("families")
}

model ClubCategory {
  id Int @id @default(autoincrement())
  name String
  description String?
  createdAt DateTime @default(now()) @map("created_at")

  clubs Club[]
  @@map("club_categories")
}

model Club {
  id Int @id @default(autoincrement())
  name String
  description String?
  classCategoryId Int @map("class_category_id")
  defaultTeacherId Int @map("default_teacher_id")
  maxStudents Int? @map("max_students")
  ageFrom Int? @map("age_from")
  ageTo Int? @map("age_to")
  color String? @default("#6366f1")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  clubCategory ClubCategory @relation(fields: [classCategoryId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [defaultTeacherId], references: [id])
  clubServices ClubService[]

  @@map("clubs")
}

model ClubService {
  id Int @id @default(autoincrement())
  name String
  priceTrialLesson Float? @map("price_trial_lesson")
  pricePerLesson Float? @map("price_per_lesson")
  priceSubscription Float? @map("price_subscription")
  subscriptionLessons Int @map("subscription_lessons")
  clubId Int @map("club_id")
  createdAt DateTime @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@map("club_services")
}