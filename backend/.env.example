# Переменные backend (копировать в backend/.env).
# В Docker Compose backend подхватывает этот файл через env_file.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Локально — порт из корневого .env (POSTGRES_PORT, по умолчанию 5433).
# В Docker Compose DATABASE_URL переопределяется в docker-compose.yml.
DATABASE_URL=postgresql://educrm:educrm@localhost:5433/educrm?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# SMTP Yandex (восстановление пароля и уведомления)
YANDEX_EMAIL=your@yandex.ru
YANDEX_PASSWORD=app-password
EMAIL_FROM_NAME=Пристань авантюристов

# Telegram Mini App — проверка initData
BOT_TOKEN=

# Первый администратор (seed создаёт запись только если в БД нет роли ADMIN)
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Имя
ADMIN_LAST_NAME=Фамилия
ADMIN_PHONE=89001234567

# Второй администратор (разработчик)
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_FIRST_NAME=Имя
DEV_ADMIN_LAST_NAME=Фамилия
DEV_ADMIN_PHONE=89001234567
